# Coherent, version-matched Open-RMF source set for ROS 2 Jazzy, frozen to exact
# commits from open-rmf/rmf @ branch `jazzy` (resolved 2026-06-20). Built fully from
# source — the Jazzy binary feed is incomplete/mismatched for this stack (no
# reservation packages; demos require them). Integrity = digest-pinned base + these
# exact commit pins + rosdep from GPG-signed repos. Regenerate by re-resolving the
# `jazzy` branch HEADs of open-rmf/rmf's rmf.repos.
repositories:
  demonstrations/rmf_demos:
    type: git
    url: https://github.com/open-rmf/rmf_demos.git
    version: 3f7b9727ce39ba421ba5727eed9d8612f1c85f66
